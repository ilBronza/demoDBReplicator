{
    "name": "ilbronza/demodbreplicator",
    "description": "Replicate a db inside another",
    "license": "MIT",
    "authors": [
        {
            "name": "Davide Bronzini",
            "email": "davide@sistema.srl",
            "homepage": "https://sistema.srl"
        }
    ],
    "homepage": "https://github.com/ilbronza/demodbreplicator",
    "keywords": ["Laravel", "DemoDBReplicator"],
    "require": {
        "symfony/process": "^5.4 || ^6.0 || ^7.0 || ^8.0"
    },
    "require-dev": {
    },
    "autoload": {
        "psr-4": {
            "IlBronza\\DemoDBReplicator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IlBronza\\DemoDBReplicator\\Tests\\": "tests",
            "App\\Http\\Controllers\\": "tests/Fixtures/App/Http/Controllers"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "IlBronza\\DemoDBReplicator\\DemoDBReplicatorServiceProvider"
            ],
            "aliases": {
                "DemoDBReplicator": "IlBronza\\DemoDBReplicator\\Facades\\DemoDBReplicator"
            }
        }
    }
}
